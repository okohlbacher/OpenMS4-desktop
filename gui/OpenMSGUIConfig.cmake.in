@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(OpenMS 4.0.0 EXACT CONFIG)
find_dependency(OpenMSCLI 1.0.0 EXACT CONFIG)
if(NOT "${OpenMS_SOURCE_REVISION}" STREQUAL "@OpenMS_SOURCE_REVISION@")
  message(FATAL_ERROR "OpenMSGUI was compiled for a different OpenMS source revision")
endif()
if(NOT "${OpenMSCLI_SOURCE_REVISION}" STREQUAL "@OpenMSCLI_SOURCE_REVISION@")
  message(FATAL_ERROR "OpenMSGUI was compiled for a different OpenMSCLI source revision")
endif()
find_dependency(Qt6 6.1 COMPONENTS @_qt_components@)
set(OpenMSGUI_SOURCE_REVISION "@OpenMSGUI_SOURCE_REVISION@")
set(OpenMSGUI_SOURCE_DIRTY "@OpenMSGUI_SOURCE_DIRTY@")
set(OpenMSGUI_VERSION "@PROJECT_VERSION@")
include("${CMAKE_CURRENT_LIST_DIR}/OpenMSGUITargets.cmake")
check_required_components(OpenMSGUI)
